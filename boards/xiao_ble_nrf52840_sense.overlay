#include "xiao_ble_nrf52840.overlay"

/* The board DTS turns on the internal IMU regulator by default. This
 * application uses the external BMA400; let the GPIO hogs keep it off.
 */
/ {
	/delete-node/ lsm6ds3tr-c-en;
	/delete-node/ msm261d3526hicpm-c-en;
};
