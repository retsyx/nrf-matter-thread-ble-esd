#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	aliases {
		mailbox-motion = &mailbox_motion;
		mailbox-battery = &mailbox_battery;
	};
	mailbox_motion: mailbox-motion {
		compatible = "mailbox,gpio-signal";
		gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>; /* D2, BMA400 INT1 */
	};
	mailbox_battery: mailbox-battery {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		output-ohms = <510000>;
		full-ohms = <1510000>;
		/* P0.14 stays LOW: switching off the lower divider leg can
		 * overvoltage P0.31 while charging. See Seeed's current FAQ Q3.
		 */
	};
	mailbox_flash_sleep: mailbox-flash-sleep {
		compatible = "mailbox,spi-flash-sleep";
		cs-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
		sck-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
		wp-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
		hold-gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
	};
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	zephyr,pm-device-runtime-auto;
	status = "okay";
	mailbox_bma400: bma400@14 {
		compatible = "bosch,bma400";
		reg = <0x14>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

&gpio0 {
	/* INT1 uses low-power GPIO SENSE/PORT events instead of an IN channel. */
	sense-edge-mask = <0x10000000>;
	rgb_off {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>, <26 GPIO_ACTIVE_HIGH>, <30 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "RGB LEDs off";
	};
	battery_divider_safe {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "Battery divider enabled safely";
	};
	flash_cs_idle {
		gpio-hog;
		gpios = <25 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "Unused external flash deselected";
	};
};
&gpio1 {
	sense_power_off {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>, <10 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "Unused Sense IMU and microphone off";
	};
};

/* Only the external BMA400, ADC, and radio are needed for this sensor. */
&i2c0 { status = "disabled"; };
&uart0 { status = "disabled"; };
&spi2 { status = "disabled"; };
&qspi { status = "disabled"; };
/* Child status is independent: leaving this okay still instantiates the NOR
 * driver and initializes QSPI before main, even with its controller disabled.
 * The application instead puts this unused flash into deep power-down.
 */
&p25q16h { status = "disabled"; };
&pwm0 { status = "disabled"; };
&pdm0 { status = "disabled"; };
&usbd { status = "disabled"; };
